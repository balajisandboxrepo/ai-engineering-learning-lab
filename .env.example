# Copy this file to .env and fill in the credentials you use.
# Never commit .env or put real credentials in this template.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Optional: Qwen-compatible endpoint settings.
# Defaults are a local vLLM-compatible endpoint and model id.
# QWEN_BASE_URL=http://127.0.0.1:8000/v1
# QWEN_API_KEY=local
# QWEN_MODEL=Qwen/Qwen3.8-27B
